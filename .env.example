# Token del bot de Telegram (obtenerlo de @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Tu ID de Telegram (obtenerlo con @userinfobot)
TELEGRAM_ALLOWED_USERS=123456789

# --- Ollama (local, recomendado) ---
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=llama3.1:8b-16k

# --- OpenAI (cloud, alternativa) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

DATABASE_PATH=data/tasks.db

# KnowledgeVault (Obsidian) — contexto para herramientas
VAULT_PATH=/home/lisandro/KnowledgeVault/KnowledgeVault

# Memoria conversacional (mensajes por usuario)
MEMORY_MAX_MESSAGES=20

# Comandos shell permitidos (prefijos separados por coma)
SHELL_ALLOWED_PREFIXES=ls,cat,head,tail,grep,find,git status,git log,ollama list,ollama ps

# Rate limit: mensajes por usuario por minuto
RATE_LIMIT_PER_MINUTE=10

# Scheduler: intervalo de chequeo de recordatorios (segundos)
SCHEDULER_INTERVAL_SECONDS=30

# Log a archivo (opcional; en Docker: /app/data/assistant.log)
# LOG_FILE=data/assistant.log

# Health endpoint HTTP (Docker expone 8080 → host 10850)
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080

# --- Wekan (kanban) ---
WEKAN_API_URL=http://127.0.0.1:10550/api
WEKAN_API_TOKEN=your_wekan_api_token
WEKAN_AUTHOR_ID=your_wekan_user_id
WEKAN_USER_ID=your_wekan_user_id
WEKAN_PUBLIC_URL=http://wekan.home.lan
# Escritura de espacios de trabajo (perfil de usuario en Mongo/FerretDB; no hay REST)
# WEKAN_MONGO_URL=mongodb://ferretdb:27017/wekan

# --- Voz (microservicios offline-ai-microservices) ---
# STT_BASE_URL=http://127.0.0.1:8010
# TTS_BASE_URL=http://127.0.0.1:8011
# En Docker (misma red ai-net):
# STT_BASE_URL=http://offline-ai-stt:8000
# TTS_BASE_URL=http://offline-ai-tts:8000
# VOICE_REPLIES=false

# --- Docker Compose ---
# WEKAN_API_URL=http://host.docker.internal:10550/api
# VAULT_HOST_PATH=/home/lisandro/KnowledgeVault/KnowledgeVault
# ASSISTANT_HOST_BIND=127.0.0.1
# ASSISTANT_HOST_PORT=10850
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
